<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Contact Widget"
        android:supportsRtl="true"
        android:theme="@style/Theme.ContactWidget"
        tools:targetApi="31">

        <!-- Main Settings / Configuration Activity -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Translucent Radial Sun Menu Overlay Activity -->
        <activity
            android:name=".SunMenuActivity"
            android:exported="true"
            android:theme="@style/Theme.ContactWidget.Translucent" />

        <!-- Quick Contact AppWidget Receiver -->
        <receiver
            android:name=".QuickContactWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_contact_widget_info" />
        </receiver>

        <!-- Contact Folder AppWidget Receiver -->
        <receiver
            android:name=".ContactFolderWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/contact_folder_widget_info" />
        </receiver>

    </application>

</manifest>
